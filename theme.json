{
  "_comment": "Style/brand definition for slidebuilder. The color hex codes and font name below are UNVERIFIED PLACEHOLDERS -- replace them with your actual approved Cisco brand values before using this for real decks. Everything under 'styles' is a named preset: reference it from an element with \"style\": \"<name>\"; any field can still be overridden per-element. Values written as \"$name\" resolve against 'colors'.",

  "colors": {
    "primary": "#1F4E79",
    "secondary": "#70AD47",
    "accent": "#FF8200",
    "dark": "#000000",
    "light": "#FFFFFF",
    "muted": "#666666",
    "navy": "#0D274D",
    "cyan": "#00BCEB",
    "blue": "#0051AF",
    "amber": "#FBAB2C",
    "green": "#74BF4B",
    "background": "#FFFFFF",
    "red": "#E3241B",
    "purple": "#7030A0",
    "grey_light": "#E2E2E2",
    "grey_text": "#414244",
    "white": "#FFFFFF",
    "black": "#000000",
    "palette": ["#1F4E79", "#0D274D", "#70AD47", "#FF8200", "#A9A9A9"]
  },

  "styles": {
    "title": {
      "font_family": "Arial",
      "font_size": 32,
      "bold": true,
      "font_color": "$light",
      "fill_color": "$primary",
      "line_color": null,
      "align": "center",
      "valign": "middle"
    },
    "title_banner": {
      "font_family": "CiscoSansTT ExtraLight",
      "font_size": 40,
      "bold": false,
      "font_color": "$white",
      "fill_color": "$navy",
      "line_color": null,
      "align": "center",
      "valign": "middle"
    },
     "card": {
      "fill_color": "$white",
      "line_color": "$cyan",
      "line_width": 1.5
    },
    "card_title": {
      "font_family": "CiscoSansTT Light",
      "font_size": 16,
      "bold": true,
      "font_color": "$cyan",
      "align": "left",
      "valign": "top"
    },
    "card_body": {
      "font_family": "CiscoSansTT Light",
      "font_size": 14,
      "bold": false,
      "font_color": "$black",
      "align": "left",
      "valign": "top"
    },
    "subtitle": {
      "font_family": "Arial",
      "font_size": 20,
      "bold": true,
      "font_color": "$primary",
      "align": "left",
      "valign": "top"
    },
    "body": {
      "font_family": "Arial",
      "font_size": 14,
      "bold": false,
      "font_color": "$dark",
      "align": "left",
      "valign": "top"
    },
    "caption": {
      "font_family": "Arial",
      "font_size": 10,
      "italic": true,
      "font_color": "$muted",
      "align": "left",
      "valign": "top"
    },
    "callout": {
      "font_family": "Arial",
      "font_size": 16,
      "bold": true,
      "font_color": "$light",
      "fill_color": "$secondary",
      "line_color": "$secondary",
      "align": "center",
      "valign": "middle"
    },
    "table": {
      "font_family": "Arial",
      "font_size": 12,
      "font_color": "$dark",
      "align": "left",
      "fill_color": "$background",
      "header_fill_color": "$primary",
      "header_font_color": "$light"
    },
    "process": {
      "font_family": "Arial",
      "font_size": 14,
      "bold": true,
      "font_color": "$primary",
      "fill_color": "$light",
      "line_color": "$primary",
      "line_width": 1.5,
      "align": "center",
      "valign": "middle"
    },
    "connector": {
      "line_color": "$muted",
      "line_width": 1.5,
      "arrow_end": true
    },
    "badge_navy": { "fill_color": "$navy", "line_color": null },
    "badge_cyan": { "fill_color": "$cyan", "line_color": null },
    "badge_amber": { "fill_color": "$amber", "line_color": null },
    "badge_green": { "fill_color": "$green", "line_color": null },
    "badge_red": { "fill_color": "$red", "line_color": null },
    "badge_purple": { "fill_color": "$purple", "line_color": null }
  }
}
